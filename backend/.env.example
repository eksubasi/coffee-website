# Local development values only. Copy to backend/.env and never commit .env.
SECRET_KEY=local-development-only-change-before-deployment
DATABASE_URL=postgres://brewnook:local-dev-only@localhost:5432/brewnook
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Password for users created by `manage.py seed_users` (default: brewnook-demo).
DEMO_PASSWORD=brewnook-demo
# SameSite policy for the refresh-token cookie (default: Lax).
# AUTH_REFRESH_COOKIE_SAMESITE=Lax
# Production only (config.settings.prod):
# ALLOWED_HOSTS=api.example.com
