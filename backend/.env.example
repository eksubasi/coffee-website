# Local development values only. Copy to backend/.env and never commit .env.
SECRET_KEY=local-development-only-change-before-deployment
DATABASE_URL=postgres://brewnook:local-dev-only@localhost:5432/brewnook
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Password for users created by `manage.py seed_users` (default: brewnook-demo).
DEMO_PASSWORD=brewnook-demo
# SameSite policy for the refresh-token cookie (default: Lax).
# AUTH_REFRESH_COOKIE_SAMESITE=Lax
# Production only (config.settings.prod):
# ALLOWED_HOSTS=api.example.com

# Email: local development prints messages to the backend terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Brewnook <noreply@example.com>

# For real delivery, select the SMTP backend and configure your provider.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=15
